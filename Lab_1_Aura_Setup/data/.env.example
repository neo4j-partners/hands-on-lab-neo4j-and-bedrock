# =============================================================================
# Neo4j Database Connection (Required)
# =============================================================================

# Neo4j connection URI (e.g., neo4j+s://xxx.databases.neo4j.io)
NEO4J_URI=

# Neo4j database name
NEO4J_DATABASE=neo4j

# Neo4j credentials
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# =============================================================================
# AWS S3 Configuration (Optional - for upload)
# =============================================================================

# AWS credentials (leave empty to use default AWS credential chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region for S3 bucket
AWS_REGION=us-east-1

# S3 bucket name for uploading exported CSVs
S3_BUCKET=

# S3 key prefix (folder path) for exports
S3_PREFIX=neo4j-export/
